@echo off
REM =====================================================================
REM  AI Adventure Master - free AI chat AND local image generator (Windows)
REM
REM  ONE file that runs both other one-file downloads at the same time, in
REM  the same window:
REM
REM    - the free AI's TEXT chat: a local relay (arena.ai's Max router
REM      first, then DeepSeek / TryingOpen) on 127.0.0.1:8003, so completions
REM      leave from THIS machine's own IP instead of drawing on the site's
REM      small shared hourly budget. The helper Chrome stays off the taskbar,
REM      even while you sign in or tick its rare human check; TryingOpen uses
REM      that same hidden Chrome page because its endpoint requires it. Every
REM      window of the real Chrome process is re-styled four times a second, and
REM      a login/ban/quota answer pauses only that provider for ten minutes;
REM      Gemini web chat is enabled; one --gemini-login Google sign-in is needed;
REM    - image generation: the local image worker (imagefree.net's own API)
REM      on 127.0.0.1:8002, plus the AI Horde / Pollinations relay, so the
REM      pictures are drawn here and the shared server IP keeps its per-IP
REM      limits for itself.
REM
REM  It is the pair StartFreeChat.bat + StartImageGenerator.bat with one
REM  difference, and that difference is why it exists: the Python setup runs
REM  ONCE for both workers - one interpreter lookup, one portable download
REM  if the PC has none, one virtualenv with the three packages they both
REM  need - instead of once per file.
REM
REM  A single connector announces both capabilities (-Chat -Image), so the
REM  site sees one connected machine doing both jobs. Do NOT run this file
REM  together with StartFreeChat.bat or StartImageGenerator.bat: whichever
REM  of them carries the same token takes over the connection and the other
REM  keeps reconnecting for it, so one of the two jobs silently stops being
REM  offloaded. One of the three files at a time is the rule.
REM
REM  Usage: download it and double-click it (or run "StartImage+Chat").
REM  Keep this window open while you play: closing it stops both workers
REM  and disconnects this computer.
REM
REM  Built by tools\build-both-bat.ps1 from:
REM    tools\StartLocalAI-connector.ps1   (the WebSocket half)
REM    tools\StartLocalBothWorkers.ps1    (starts BOTH Python workers)
REM    tools\local-chat-worker.py         (the chat relay itself)
REM    tools\local-image-worker.py        (the image worker itself)
REM =====================================================================

setlocal EnableExtensions
title AI Adventure Master - free AI chat + image generator v1.1.16

set "VERSION=1.1.16"
REM  The one site this file is for, written in on purpose - see
REM  StartImageGenerator.bat.in for the same reasoning.
set "HOMESITE=https://aiadventuremaster.space"

REM  Everything lives in a stable folder in the user's own profile, not in
REM  %TEMP%: the shared Python virtualenv is created next to the workers, and
REM  keeping both there means the first run installs its tools once and every
REM  later run starts in seconds.
set "BASEDIR=%LOCALAPPDATA%\AIAdventureMaster\both"
set "PS1=%BASEDIR%\aim-connector.ps1"
set "WORKERPS1=%BASEDIR%\workers.ps1"
set "CHATPY=%BASEDIR%\local-chat-worker.py"
set "IMAGEPY=%BASEDIR%\local-image-worker.py"
set "PSERR=%BASEDIR%\connector-%RANDOM%.err"
set "TRACE=%LOCALAPPDATA%\AIAdventureMaster\both-trace.log"
set "STATEDIR=%LOCALAPPDATA%\AIAdventureMaster"
set "STATE=%STATEDIR%\connector-both.json"
set "WORKERLOG=%BASEDIR%\workers.log"
set "CHATPORT=8003"
set "IMAGEPORT=8002"
set "SITE="
set "TOKEN="
set "AIMEND="
set "AGENTPID="
set "CHATWORKERPID="
set "IMGWORKERPID="
set "CHATUP="
set "IMGUP="
set "WARGS="
set "chatmisses=0"
set "imgmisses=0"

if not exist "%BASEDIR%" md "%BASEDIR%" >nul 2>&1

echo.
echo   AI Adventure Master - free AI chat + image generator v%VERSION%
echo   ----------------------------------------------------------
echo.

echo   [1/5] Preparing both workers...
set "EXVER="
if exist "%BASEDIR%\.extracted-version" set /p EXVER=<"%BASEDIR%\.extracted-version"
if "%EXVER%"=="%VERSION%" if exist "%PS1%" if exist "%WORKERPS1%" if exist "%CHATPY%" if exist "%IMAGEPY%" goto :files_cached
call :write_files
if not exist "%PS1%" goto :extract_failed
if not exist "%WORKERPS1%" goto :extract_failed
if not exist "%CHATPY%" goto :extract_failed
if not exist "%IMAGEPY%" goto :extract_failed
> "%BASEDIR%\.extracted-version" echo %VERSION%
echo         Files ready.
goto :files_done
:files_cached
echo         Files ready (up to date).
:files_done

REM  Only the workers that are not already answering are (re)started: closing
REM  the console does NOT kill the background python processes, so the usual
REM  second run finds them alive and must not fight them for their ports.
echo.
echo   [2/5] Starting the chat relay and the image worker...
call :worker_up %CHATPORT%
if not errorlevel 1 set "CHATUP=1"
call :worker_up %IMAGEPORT%
if not errorlevel 1 set "IMGUP=1"
if defined CHATUP if defined IMGUP goto :workers_already_up
set "WARGS=-ChatPort %CHATPORT% -ImagePort %IMAGEPORT%"
if not defined CHATUP set "WARGS=%WARGS% -Chat"
if not defined IMGUP set "WARGS=%WARGS% -Image"
call :start_workers
echo.
echo         The first run downloads a private Python and its tools once
echo         (~1-2 minutes) and can take a little longer on a slow
echo         connection. It is one setup for BOTH workers, and its setup
echo         window closes by itself once they are running in the background
echo         - keep THIS window open while you play.
echo.
goto :after_start_workers
:workers_already_up
echo         Chat relay already running on %CHATPORT% and image worker on
echo         %IMAGEPORT% - skipping setup.
:after_start_workers

echo.
echo   [3/5] Waiting for both to answer on ports %CHATPORT% and %IMAGEPORT%...
call :curl_ok || goto :no_curl
call :wait_worker "chat relay" %CHATPORT% local-chat-worker.py
if not defined WREADY goto :worker_failed
set "CHATWORKERPID=%WREADYPID%"
call :trace "chat relay ready on %CHATPORT%"
call :wait_worker "image worker" %IMAGEPORT% local-image-worker.py
if not defined WREADY goto :worker_failed
set "IMGWORKERPID=%WREADYPID%"
call :trace "image worker ready on %IMAGEPORT%"
echo         Both are ready.

echo.
echo   [4/5] Working out your address on the site...
call :resolve_site
if errorlevel 1 goto :nosite
call :resolve_token
if errorlevel 1 goto :nosite
set "AIMEND=%SITE%/ai/%TOKEN%/v1"
call :save_state
call :trace "site=%SITE% endpoint=%AIMEND%"
echo         Site:    %SITE%

echo.
echo   [5/5] Connecting this computer to the site...
where powershell >nul 2>&1
if errorlevel 1 goto :noproxy
call :start_agent
if not defined AGENTPID goto :agent_failed
call :trace "agent started, pid %AGENTPID%"

echo.
echo   Done.
echo.
echo   The free AI's text chat AND image generation now run on THIS computer,
echo   with THIS computer's own IP, and the site sees them as one connected
echo   machine.
echo.
echo   Keep this window open while you play - closing it stops both workers
echo   and disconnects this computer.
echo.
echo   Press Ctrl+C or close this window to stop.
goto :wait

REM ---------------------------------------------------------------------
REM  Keep the window open and watch all three halves. The connector
REM  reconnects on its own; if a process is truly gone, say so once.
REM ---------------------------------------------------------------------
:wait
ping -n 4 127.0.0.1 >nul
call :agent_alive
if not defined ALIVE goto :agent_died
call :find_worker local-chat-worker.py
if not defined FOUND_PID goto :chat_died
call :find_worker local-image-worker.py
if not defined FOUND_PID goto :img_died
set "chatmisses=0"
set "imgmisses=0"
goto :wait

:chat_died
REM  The agent still runs, but no text can be relayed without the chat
REM  worker, so say so once and keep watching - the window is not closed
REM  over it.
if %chatmisses% GEQ 1 goto :wait
set /a chatmisses+=1
echo.
echo   The chat relay has stopped, so the free AI's text chat will fall back
echo   to the server. Close this window and run the file again to restart it.
goto :wait

:img_died
REM  Same for the pictures: the image worker can die on its own while the
REM  chat relay keeps working.
if %imgmisses% GEQ 1 goto :wait
set /a imgmisses+=1
echo.
echo   The image worker has stopped, so images cannot be drawn any more.
echo   Close this window and run the file again to restart it.
goto :wait

REM ---------------------------------------------------------------------
REM  From here down is the shared machinery, the two single-purpose files
REM  side by side: one setup window for both workers, one connector with
REM  both capabilities, one watchdog.
REM ---------------------------------------------------------------------
:worker_failed
call :cleanup
echo.
echo         The %WNAME% did not start, or did not answer on port %WPORT%.
echo.
echo         Python does NOT have to be installed in advance - the workers
echo         download their own copy on the first run. The usual causes are:
echo           - no internet, or a proxy/firewall blocks python.org,
echo             bootstrap.pypa.io or pypi.org;
echo           - antivirus blocked the hidden Python window;
echo           - port %WPORT% is already taken by another program.
echo.
echo         The setup log (with the exact reason) is here:
echo           %WORKERLOG%
echo.
echo         A log of this run was left here:
echo           %TRACE%
echo.
call :stay
endlocal
exit /b 3

:agent_died
call :trace "agent process is gone"
call :cleanup
echo.
echo   The connector stopped. Close this window and run the file again.
call :stay
endlocal
exit /b 0

:agent_failed
call :cleanup
echo.
echo         The connector process did not start.
echo.
if exist "%PSERR%" for /f "usebackq delims=" %%L in ("%PSERR%") do echo         %%L
echo.
echo         Close any other copy of this file, or the two single-purpose
echo         files, and run it again.
echo.
echo         A log of this run was left here:
echo           %TRACE%
echo.
call :stay
endlocal
exit /b 3

:extract_failed
echo.
echo         This copy of the file is damaged: its own scripts could not be
echo         unpacked. Download it again from the Settings page of the site.
echo.
call :trace "embedded files could not be written"
call :stay
endlocal
exit /b 4

:nosite
call :cleanup
echo         This copy of the file is damaged: the address of the site it
echo         belongs to is missing from it.
echo.
echo         Download the latest StartImage+Chat installer from the Settings
echo         page of the site, and run the copy you get there.
echo.
call :trace "no site address"
call :stay
endlocal
exit /b 4

:noproxy
call :cleanup
echo         The connector could not start.
echo.
echo         This file needs Windows PowerShell, which comes with Windows.
echo         Close any other copy of this file and run it again.
echo.
if exist "%PSERR%" for /f "usebackq delims=" %%L in ("%PSERR%") do echo         %%L
echo.
call :trace "connector did not start"
call :stay
endlocal
exit /b 3

:no_curl
call :cleanup
echo.
echo         Cannot wait for the workers: curl.exe is not available on this PC.
echo         The health check needs curl - it ships with Windows 10 version
echo         1803 and later, so most PCs already have it. Install curl (or
echo         run this file on a machine that has it) and try again.
echo.
call :trace "curl.exe missing"
call :stay
endlocal
exit /b 3

REM ---------------------------------------------------------------------
REM  Keep this window on screen until it has actually been read.
REM ---------------------------------------------------------------------
:stay
echo.
echo   Press any key to close this window.
pause >nul 2>&1
timeout /t 4 /nobreak >nul 2>&1
goto :eof

:trace
>>"%TRACE%" echo %date% %time% %~1
goto :eof

REM  Both helpers report a missing address with an exit code rather than a
REM  `goto :nosite`, because a goto inside a called label does not come back:
REM  it would land in the error path and then return only from the CALL, so the
REM  main flow would carry on as if the site had been found.
:resolve_site
set "SITE=%HOMESITE%"
:trim_site
if "%SITE:~-1%"=="/" (
    set "SITE=%SITE:~0,-1%"
    goto :trim_site
)
if not defined SITE exit /b 1
if not "%SITE:~0,8%"=="https://" if not "%SITE:~0,7%"=="http://" exit /b 1
goto :eof

REM  One token for both jobs: the connector announces chat and image over the
REM  same socket, so a second token would only look like a second computer.
:resolve_token
if exist "%STATE%" for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "if (Test-Path '%STATE%') { $j = Get-Content -Raw '%STATE%' -ErrorAction SilentlyContinue | ConvertFrom-Json; if ($j.token) { Write-Output ($j.token) } }" 2^>nul`) do (
    if not defined TOKEN set "TOKEN=%%T"
)
if defined TOKEN goto :eof
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "$b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')"`) do set "TOKEN=%%T"
if not defined TOKEN exit /b 1
goto :eof

:save_state
if not exist "%STATEDIR%" md "%STATEDIR%" >nul 2>&1
powershell -NoProfile -Command "$o = [ordered]@{ site = '%SITE%'; token = '%TOKEN%'; port = 0; basePath = 'ROOT' }; [IO.File]::WriteAllText('%STATE%', ($o | ConvertTo-Json))" >nul 2>&1
goto :eof

REM ---------------------------------------------------------------------
REM  Start the shared worker setup in its OWN window. That window installs
REM  whatever is missing for BOTH workers, starts the ones asked for in the
REM  background and closes itself - so there is no long-lived powershell here
REM  to wait for. Readiness is confirmed by :wait_worker below.
REM ---------------------------------------------------------------------
:start_workers
start "AI Adventure Master - chat + image setup" powershell -NoProfile -ExecutionPolicy Bypass -File "%WORKERPS1%" %WARGS%
ping -n 2 127.0.0.1 >nul
goto :eof

REM ---------------------------------------------------------------------
REM  Wait until one worker answers on its health route. The first run can
REM  spend minutes installing, so this is patient. It keeps waiting only while
REM  something is still bringing the workers up - the setup window or the
REM  worker process itself. If neither exists and the health route is still
REM  down, that worker died during startup.
REM
REM  %1 the name used in messages, %2 its port, %3 its python script name.
REM ---------------------------------------------------------------------
:wait_worker
set "WNAME=%~1"
set "WPORT=%~2"
set "WSCRIPT=%~3"
set "WREADY="
set "WREADYPID="
set /a wtries=0
:ww_loop
call :worker_up %WPORT%
if not errorlevel 1 goto :ww_ready
set "FOUND_PID="
call :find_pid "%WORKERPS1%"
if defined FOUND_PID goto :ww_more
set "FOUND_PID="
call :find_worker %WSCRIPT%
if defined FOUND_PID goto :ww_more
goto :eof
:ww_more
set /a wtries+=1
if %wtries% GEQ 200 goto :eof
echo         still waiting for the %WNAME%... (%wtries%)
ping -n 6 127.0.0.1 >nul
goto :ww_loop
:ww_ready
set "WREADY=1"
set "FOUND_PID="
call :find_worker %WSCRIPT%
if defined FOUND_PID set "WREADYPID=%FOUND_PID%"
goto :eof

:curl_ok
where curl.exe >nul 2>&1
goto :eof

REM ---------------------------------------------------------------------
REM  Does that port answer its health route? %1 is the port.
REM ---------------------------------------------------------------------
:worker_up
set "WCODE="
for /f "usebackq delims=" %%C in (`curl.exe -s -o NUL -m 3 -w "%%{http_code}" "http://127.0.0.1:%~1/healthz" 2^>nul`) do set "WCODE=%%C"
if "%WCODE%"=="200" exit /b 0
exit /b 1

REM ---------------------------------------------------------------------
REM  Start the connector itself: the PowerShell half written into %PS1%.
REM  No local AI (TargetPort 0), and BOTH kinds of offload on (-Chat -Image),
REM  so one connection serves both workers. No window of its own - it shares
REM  the console being watched.
REM ---------------------------------------------------------------------
:start_agent
set "AGENTPID="
start "aim-connector" /b powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" -Mode agent -Site "%SITE%" -Token "%TOKEN%" -TargetPort 0 -BasePath ROOT -Chat -ChatPort %CHATPORT% -Image -ImagePort %IMAGEPORT% >"%PSERR%" 2>&1
set /a waits=0
:sa_pid
ping -n 2 127.0.0.1 >nul
set /a waits+=1
set "FOUND_PID="
call :find_pid "%PS1%"
if defined FOUND_PID (
    set "AGENTPID=%FOUND_PID%"
    goto :eof
)
if %waits% GEQ 15 goto :eof
goto :sa_pid

REM ---------------------------------------------------------------------
REM  Is the connector still there? Found by its command line.
REM  The pipes below live inside the quoted -Command argument, so they are
REM  NOT escaped as ^| - see StartLocalAI.bat.in for the full reasoning.
REM ---------------------------------------------------------------------
:agent_alive
set "ALIVE="
call :find_pid "%PS1%"
if defined FOUND_PID set "ALIVE=1"
goto :eof

:find_pid
set "FOUND_PID="
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq 'powershell.exe' -and $_.CommandLine -like '*%~1*' } | Select-Object -First 1 -ExpandProperty ProcessId" 2^>nul`) do set "FOUND_PID=%%P"
goto :eof

REM ---------------------------------------------------------------------
REM  Is that worker still there? A worker is the python process running its
REM  own script - NOT the setup window, which closes by design once the
REM  workers are up. Found by the script name in its command line, so it works
REM  no matter which interpreter the shared virtualenv uses. %1 is that name.
REM ---------------------------------------------------------------------
:find_worker
set "FOUND_PID="
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*%~1*' -and $_.Name -like 'python*' } | Select-Object -First 1 -ExpandProperty ProcessId" 2^>nul`) do set "FOUND_PID=%%P"
goto :eof

REM ---------------------------------------------------------------------
REM  Stop what this file started. The unpacked scripts and the shared
REM  virtualenv are left in place on purpose, so the next run is fast.
REM ---------------------------------------------------------------------
:cleanup
if defined AGENTPID taskkill /PID %AGENTPID% /F >nul 2>&1
set "AGENTPID="
if defined CHATWORKERPID taskkill /PID %CHATWORKERPID% /T /F >nul 2>&1
set "CHATWORKERPID="
if defined IMGWORKERPID taskkill /PID %IMGWORKERPID% /T /F >nul 2>&1
set "IMGWORKERPID="
REM  Fall back to finding a stray worker by name: a captured PID can be gone
REM  while another process still listens on the port.
set "FOUND_PID="
call :find_worker local-chat-worker.py
if defined FOUND_PID taskkill /PID %FOUND_PID% /T /F >nul 2>&1
set "FOUND_PID="
call :find_worker local-image-worker.py
if defined FOUND_PID taskkill /PID %FOUND_PID% /T /F >nul 2>&1
del /q "%PSERR%" >nul 2>&1
goto :eof

REM ---------------------------------------------------------------------
REM  Put the four embedded files on disk:
REM    %PS1%        the connector PowerShell half
REM    %WORKERPS1%  the shared launcher for BOTH python workers
REM    %CHATPY%     the chat relay itself (Python)
REM    %IMAGEPY%    the image worker itself (Python)
REM  The text travels as base64 because a batch file cannot carry a script
REM  block with braces and quotes intact. The plain-text originals live in
REM  tools\ and are the source of truth.
REM ---------------------------------------------------------------------
:write_files
>"%PS1%.b64" echo 77u/IyBUaGUgUG93ZXJTaGVsbCBoYWxmIG9mIFN0YXJ0TG9jYWxBSS5iYXQuDQojDQojIEl0IGlz
>>"%PS1%.b64" echo IGtlcHQgaGVyZSBhcyBhIHBsYWluIGZpbGUgYW5kIHRoZSAuYmF0IGNhcnJpZXMgYSBiYXNlNjQg
>>"%PS1%.b64" echo Y29weSBvZiBpdCwgc28NCiMgdGhhdCBjaGFuZ2luZyB0aGlzIHRleHQgZG9lcyBub3QgbWVhbiBy
