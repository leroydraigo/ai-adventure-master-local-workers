@echo off
REM =====================================================================
REM  AI Adventure Master - free AI chat relay (Windows)
REM
REM  ONE file for the free AI's TEXT chat. It starts the local chat relay
REM  on 127.0.0.1:8003 and connects this computer to the site, so the free
REM  AI's text completions run on THIS machine, with THIS machine's own
REM  IP. That matters because the free text providers limit requests per
REM  source IP, and every player sharing the server's address draws from
REM  the same small hourly budget. Running the relay here spreads that
REM  load onto your own connection instead - so the free AI answers faster
REM  and is less likely to hit a shared limit while you play.
REM
REM  The site tells the relay which provider to use (X-Text-Provider): the
REM  list lives in server-settings.json and ships with Arena Max first
REM  (arena.ai's router model), then DeepSeek Chat, then TryingOpen. Arena
REM  and DeepSeek need a one-time login on THIS machine; the first run opens
REM  the provider's site in a browser window and stores the session under
REM  %LOCALAPPDATA%\AIAdventureMaster\free-chat. TryingOpen needs no login,
REM  but its endpoint only answers requests made from its own web page: the
REM  same parked Chrome opens that page and sends the request there.
REM  Every request still leaves from your own connection.
REM
REM  Unlike the image generator it needs no Camoufox. DeepSeek's login uses
REM  a normal browser once; arena.ai and TryingOpen keep a small Chrome
REM  window parked off-screen afterwards (it carries the tokens those pages
REM  demand), and you only see it again for its rare human check. That Chrome
REM  never appears in the taskbar, not even while you sign in or tick that check.
REM  A watchdog re-styles EVERY window of the real Chrome process four times a
REM  second, including popups Chrome creates after launch. A login/ban/quota
REM  answer pauses only that provider for ten minutes instead of retrying it on
REM  every chat turn and world update. Gemini web chat is enabled like the
REM  others; it only needs one --gemini-login Google sign-in on this PC.
REM  The setup stays small (fastapi + uvicorn + httpx + websocket-client,
REM  plus wasmtime for DeepSeek) and the first run takes seconds, not minutes.
REM
REM  It uses the connector's agent mode (tools\StartLocalAI-connector.ps1)
REM  with chat offload on. No local AI is needed or looked for: this file
REM  never becomes a local-model connector.
REM
REM  Usage: download it and double-click it (or run "StartFreeChat").
REM  Keep this window open while you play: closing it stops the relay
REM  and disconnects this computer.
REM
REM  Built by tools\build-chatrelay-bat.ps1 from:
REM    tools\StartLocalAI-connector.ps1   (the WebSocket half)
REM    tools\StartLocalChatWorker.ps1    (starts the Python relay)
REM    tools\local-chat-worker.py        (the relay itself)
REM =====================================================================

setlocal EnableExtensions
title AI Adventure Master - free AI chat relay v1.2.13

set "VERSION=1.2.13"
REM  The one site this file is for, written in on purpose - see
REM  StartImageGenerator.bat.in for the same reasoning.
set "HOMESITE=https://aiadventuremaster.space"

REM  Everything lives in a stable folder in the user's own profile, not in
REM  %TEMP%: the relay's Python virtualenv is created next to its script,
REM  and keeping both there means the first run installs its tools once and
REM  every later run starts in seconds.
set "BASEDIR=%LOCALAPPDATA%\AIAdventureMaster\free-chat"
set "PS1=%BASEDIR%\aim-connector.ps1"
set "WORKERPS1=%BASEDIR%\chat-worker.ps1"
set "WORKERPY=%BASEDIR%\local-chat-worker.py"
set "PSERR=%BASEDIR%\connector-%RANDOM%.err"
set "TRACE=%LOCALAPPDATA%\AIAdventureMaster\free-chat-trace.log"
set "STATEDIR=%LOCALAPPDATA%\AIAdventureMaster"
set "STATE=%STATEDIR%\connector-chat.json"
set "CHATPORT=8003"
set "SITE="
set "TOKEN="
set "AIMEND="
set "AGENTPID="
set "WORKERPID="
set "misses=0"

if not exist "%BASEDIR%" md "%BASEDIR%" >nul 2>&1

echo.
echo   AI Adventure Master - free AI chat relay v%VERSION%
echo   ----------------------------------------------------
echo.

echo   [1/5] Preparing the chat relay...
set "EXVER="
if exist "%BASEDIR%\.extracted-version" set /p EXVER=<"%BASEDIR%\.extracted-version"
if "%EXVER%"=="%VERSION%" if exist "%WORKERPY%" if exist "%WORKERPS1%" if exist "%PS1%" goto :files_cached
call :write_files
if not exist "%WORKERPY%" goto :extract_failed
if not exist "%WORKERPS1%" goto :extract_failed
if not exist "%PS1%" goto :extract_failed
> "%BASEDIR%\.extracted-version" echo %VERSION%
echo         Files ready.
goto :files_done
:files_cached
echo         Files ready (up to date).
:files_done

echo.
echo   [2/5] Starting the chat relay...
call :worker_up
if not errorlevel 1 goto :worker_already_up
call :start_worker
echo.
echo         The first run downloads a private Python and its tools once
echo         (~1-2 minutes) and can take a little longer on a slow
echo         connection. Its setup window closes by itself once the relay
echo         is running in the background - keep THIS window open while
echo         you play.
echo.
goto :after_start_worker
:worker_already_up
set "WORKERREADY=1"
echo         Chat relay already running on %CHATPORT% - skipping setup.
:after_start_worker

echo.
echo   [3/5] Waiting for the chat relay to answer on port %CHATPORT%...
call :wait_worker
if not defined WORKERREADY goto :worker_failed
call :trace "chat relay ready on %CHATPORT%"
echo         Chat relay is ready.

echo.
echo   [4/5] Working out your address on the site...
call :resolve_site
if not defined SITE goto :nosite
call :resolve_token
if not defined TOKEN goto :nosite
set "AIMEND=%SITE%/ai/%TOKEN%/v1"
call :save_state
call :trace "site=%SITE% endpoint=%AIMEND%"
echo         Site:    %SITE%

echo.
echo   [5/5] Connecting this computer to the site...
where powershell >nul 2>&1
if errorlevel 1 goto :noproxy
call :start_agent
if not defined AGENTPID goto :agent_failed
call :trace "agent started, pid %AGENTPID%"

echo.
echo   Done.
echo.
echo   The free AI's text chat now runs on THIS computer, with THIS
echo   computer's own IP. That lightens the shared free-AI limit and
echo   usually makes replies come faster.
echo.
echo   Keep this window open while you play - closing it stops the relay
echo   and disconnects this computer.
echo.
echo   Press Ctrl+C or close this window to stop.
goto :wait

REM ---------------------------------------------------------------------
REM  Keep the window open and watch both halves. The connector reconnects
REM  on its own; if either process is truly gone, say so.
REM ---------------------------------------------------------------------
:wait
ping -n 4 127.0.0.1 >nul
call :agent_alive
if not defined ALIVE goto :agent_died
call :find_worker
if not defined FOUND_PID goto :worker_died
set "misses=0"
goto :wait

:worker_died
REM  The agent still runs, but no text can be relayed without the worker,
REM  so say so once and keep watching - the window is not closed over it.
if %misses% GEQ 1 goto :wait
set /a misses+=1
echo.
echo   The chat relay has stopped, so the free AI's text chat will fall
echo   back to the server. Close this window and run the file again to
echo   restart it.
goto :wait

REM ---------------------------------------------------------------------
REM  From here down is the shared machinery, adapted from the image
REM  generator's template (chat relay, port %CHATPORT%, -Chat offload).
REM ---------------------------------------------------------------------
:worker_failed
call :cleanup
echo.
echo         The chat relay did not start, or did not answer on port
echo         %CHATPORT%.
echo.
echo         Python does NOT have to be installed in advance - the relay
echo         downloads its own copy on the first run. Most likely causes:
echo           - no internet, or a proxy/firewall blocks python.org,
echo             bootstrap.pypa.io or pypi.org (pip needs them once);
echo           - port %CHATPORT% is already taken by another program;
echo           - antivirus blocked the hidden Python window.
echo.
echo         Exact reason is in the relay's setup log:
echo           %BASEDIR%\chat-worker.log
echo.
echo         A log of this run was left here:
echo           %TRACE%
echo.
call :stay
endlocal
exit /b 3

:agent_died
call :trace "agent process is gone"
call :cleanup
echo.
echo   The connector stopped. Close this window and run the file again.
call :stay
endlocal
exit /b 0

:agent_failed
call :cleanup
echo.
echo         The connector process did not start.
echo.
if exist "%PSERR%" for /f "usebackq delims=" %%L in ("%PSERR%") do echo         %%L
echo.
echo         Close any other copy of this file and run it again.
echo.
echo         A log of this run was left here:
echo           %TRACE%
echo.
call :stay
endlocal
exit /b 3

:extract_failed
echo.
echo         This copy of the file is damaged: its own scripts could not be
echo         unpacked. Download it again from the Settings page of the site.
echo.
call :trace "embedded files could not be written"
call :stay
endlocal
exit /b 4

:nosite
call :cleanup
echo         This copy of the file is damaged: the address of the site it
echo         belongs to is missing from it.
echo.
echo         Download the latest StartFreeChat installer from the Settings
echo         page of the site, and run the copy you get there.
echo.
call :trace "no site address"
call :stay
endlocal
exit /b 4

:noproxy
call :cleanup
echo         The connector could not start.
echo.
echo         This file needs Windows PowerShell, which comes with Windows.
echo         Close any other copy of this file and run it again.
echo.
if exist "%PSERR%" for /f "usebackq delims=" %%L in ("%PSERR%") do echo         %%L
echo.
call :trace "connector did not start"
call :stay
endlocal
exit /b 3

REM ---------------------------------------------------------------------
REM  Keep this window on screen until it has actually been read.
REM ---------------------------------------------------------------------
:stay
echo.
echo   Press any key to close this window.
pause >nul 2>&1
timeout /t 4 /nobreak >nul 2>&1
goto :eof

:trace
>>"%TRACE%" echo %date% %time% %~1
goto :eof

:resolve_site
set "SITE=%HOMESITE%"
:trim_site
if "%SITE:~-1%"=="/" (
    set "SITE=%SITE:~0,-1%"
    goto :trim_site
)
if not "%SITE:~0,8%"=="https://" if not "%SITE:~0,7%"=="http://" goto :nosite
if not defined SITE goto :nosite
goto :eof

:resolve_token
if exist "%STATE%" for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "if (Test-Path '%STATE%') { $j = Get-Content -Raw '%STATE%' -ErrorAction SilentlyContinue | ConvertFrom-Json; if ($j.token) { Write-Output ($j.token) } }" 2^>nul`) do (
    if not defined TOKEN set "TOKEN=%%T"
)
if defined TOKEN goto :eof
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "$b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')"`) do set "TOKEN=%%T"
if not defined TOKEN goto :nosite
goto :eof

:save_state
if not exist "%STATEDIR%" md "%STATEDIR%" >nul 2>&1
powershell -NoProfile -Command "$o = [ordered]@{ site = '%SITE%'; token = '%TOKEN%'; port = 0; basePath = 'ROOT' }; [IO.File]::WriteAllText('%STATE%', ($o | ConvertTo-Json))" >nul 2>&1
goto :eof

:start_worker
set "WORKERPID="
start "AI Adventure Master - chat relay" powershell -NoProfile -ExecutionPolicy Bypass -File "%WORKERPS1%"
ping -n 2 127.0.0.1 >nul
goto :eof

:wait_worker
set "WORKERREADY="
set "WORKERPID="
set /a wtries=0
call :curl_ok || goto :no_curl
echo         (if this is the first run, a portable Python and its tools are
echo         being downloaded - that can take a few minutes on a slow line)
:ww_loop
call :worker_up
if not errorlevel 1 goto :ww_ready
set "FOUND_PID="
call :find_pid "%WORKERPS1%"
if defined FOUND_PID goto :ww_more
set "FOUND_PID="
call :find_worker
if defined FOUND_PID goto :ww_more
goto :eof
:ww_more
set /a wtries+=1
if %wtries% GEQ 100 goto :eof
echo         still waiting for the relay... (%wtries%)
ping -n 6 127.0.0.1 >nul
goto :ww_loop
:ww_ready
set "WORKERREADY=1"
set "FOUND_PID="
call :find_worker
if defined FOUND_PID set "WORKERPID=%FOUND_PID%"
goto :eof

:curl_ok
where curl.exe >nul 2>&1
goto :eof

:no_curl
call :cleanup
echo.
echo         Cannot wait for the relay: curl.exe is not available on this PC.
echo         The health check needs curl - it ships with Windows 10 version
echo         1803 and later, so most PCs already have it. Install curl (or
echo         run this file on a machine that has it) and try again.
echo.
call :trace "curl.exe missing"
call :stay
endlocal
exit /b 3

:worker_up
set "WCODE="
for /f "usebackq delims=" %%C in (`curl.exe -s -o NUL -m 3 -w "%%{http_code}" "http://127.0.0.1:%CHATPORT%/healthz" 2^>nul`) do set "WCODE=%%C"
if "%WCODE%"=="200" exit /b 0
exit /b 1
REM ---------------------------------------------------------------------
REM  Start the connector itself: the PowerShell half written into %PS1%.
REM  No local AI (TargetPort 0) and chat offload on (-Chat), so it only
REM  announces chat capability and routes free-AI chat to the local relay
REM  on %CHATPORT%. No window of its own - it shares this console.
REM ---------------------------------------------------------------------
:start_agent
set "AGENTPID="
start "aim-connector" /b powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" -Mode agent -Site "%SITE%" -Token "%TOKEN%" -TargetPort 0 -BasePath ROOT -Chat -ChatPort %CHATPORT% >"%PSERR%" 2>&1
set /a waits=0
:sa_pid
ping -n 2 127.0.0.1 >nul
set /a waits+=1
set "FOUND_PID="
call :find_pid "%PS1%"
if defined FOUND_PID (
    set "AGENTPID=%FOUND_PID%"
    goto :eof
)
if %waits% GEQ 15 goto :eof
goto :sa_pid

REM ---------------------------------------------------------------------
REM  Is the connector still there? Found by its command line.
REM  The pipes below live inside the quoted -Command argument, so they are
REM  NOT escaped as ^| - see StartLocalAI.bat.in for the full reasoning.
REM ---------------------------------------------------------------------
:agent_alive
set "ALIVE="
call :find_pid "%PS1%"
if defined FOUND_PID set "ALIVE=1"
goto :eof

:find_pid
set "FOUND_PID="
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq 'powershell.exe' -and $_.CommandLine -like '*%~1*' } | Select-Object -First 1 -ExpandProperty ProcessId" 2^>nul`) do set "FOUND_PID=%%P"
goto :eof

REM ---------------------------------------------------------------------
REM  Is the relay itself still there? The relay is the python process
REM  running local-chat-worker.py - NOT the setup window, which closes by
REM  design once the relay is up. Found by the script name in its command
REM  line, so it works no matter which interpreter the venv uses.
REM ---------------------------------------------------------------------
:find_worker
set "FOUND_PID="
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*local-chat-worker.py*' -and $_.Name -like 'python*' } | Select-Object -First 1 -ExpandProperty ProcessId" 2^>nul`) do set "FOUND_PID=%%P"
goto :eof

:stop_agent
if defined AGENTPID taskkill /PID %AGENTPID% /F >nul 2>&1
set "AGENTPID="
goto :eof

REM ---------------------------------------------------------------------
REM  Stop the relay. Prefer the PID captured at startup; if that is gone,
REM  fall back to finding the python worker by name so a stray process is
REM  not left listening on the port.
REM ---------------------------------------------------------------------
:stop_worker
if not defined WORKERPID call :find_worker
if defined FOUND_PID set "WORKERPID=%FOUND_PID%"
if defined WORKERPID taskkill /PID %WORKERPID% /T /F >nul 2>&1
set "WORKERPID="
goto :eof

REM ---------------------------------------------------------------------
REM  Stop what this file started. The unpacked scripts and the relay's
REM  virtualenv are left in place on purpose, so the next run is fast.
REM ---------------------------------------------------------------------
:cleanup
call :stop_agent
call :stop_worker
del /q "%PSERR%" >nul 2>&1
goto :eof

REM ---------------------------------------------------------------------
REM  Put the three embedded files on disk:
REM    %PS1%        the connector PowerShell half
REM    %WORKERPS1%  the relay launcher
REM    %WORKERPY%   the relay itself (Python)
REM  The text travels as base64 because a batch file cannot carry a script
REM  block with braces and quotes intact. The plain-text originals live in
REM  tools\ and are the source of truth.
